import { CheckBox, ComboBox, HorizontalBox, VerticalBox } from "std-widgets.slint";

component AccentButton inherits Rectangle {
    in property <string> text;
    in property <color> fill: #6ea8fe;
    in property <bool> enabled: true;
    in property <length> label-size: 14px;
    in property <int> label-weight: 600;
    callback clicked();
    border-radius: 8px;
    background: enabled ? fill : #30333a;
    opacity: enabled ? 1 : 0.55;
    Text {
        text: root.text;
        color: #ffffff;
        font-size: root.label-size;
        font-weight: root.label-weight;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

component LogoutButton inherits Rectangle {
    callback clicked();
    border-radius: 8px;
    background: #2a2d35;
    Text {
        x: 12px;
        width: parent.width - 42px;
        text: "Sign out";
        color: #f4f6fb;
        font-size: 14px;
        font-weight: 600;
        vertical-alignment: center;
    }
    Text {
        x: parent.width - 28px;
        width: 18px;
        text: "\u{e8ac}";
        color: #c8ccd6;
        font-family: "Segoe MDL2 Assets";
        font-size: 15px;
        vertical-alignment: center;
        horizontal-alignment: center;
    }
    TouchArea { clicked => { root.clicked(); } }
}

component Field inherits VerticalBox {
    in property <string> label;
    in-out property <string> value;
    spacing: 5px;
    Text { text: root.label; color: #b7becd; font-size: 12px; }
    Rectangle {
        height: 36px;
        background: #22252d;
        border-radius: 7px;
        border-width: 1px;
        border-color: #343844;
        TextInput {
            x: 10px;
            y: 7px;
            width: parent.width - 20px;
            height: parent.height - 14px;
            text <=> root.value;
            color: #f4f6fb;
            font-size: 13px;
        }
    }
}

export component AppWindow inherits Window {
    in property <[string]> versions;
    in property <int> selected-version-index;
    in property <string> selected-version;
    in property <[string]> instances;
    in property <int> selected-instance-index;
    in property <string> account-name;
    in property <length> account-width: 210px;
    in property <image> player-head;
    in property <string> status-text;
    in property <bool> busy;
    in-out property <bool> open-console: false;
    in-out property <bool> show-settings: false;
    in-out property <bool> settings-global: false;
    in-out property <string> draft-name;
    in-out property <string> draft-version;
    in-out property <string> draft-ram;
    in-out property <string> draft-jvm-args;
    in-out property <string> draft-game-args;
    in-out property <bool> draft-ram-override;
    in-out property <bool> draft-jvm-override;
    in-out property <bool> draft-game-override;
    in property <bool> show-login-dialog: false;
    in property <bool> show-progress: false;
    in property <float> progress-value: 0;
    in property <color> accent-color: #6ea8fe;
    callback start-game();
    callback select-version(int);
    callback select-instance(int);
    callback create-instance();
    callback set-open-console(bool);
    callback open-global-settings();
    callback open-instance-settings();
    callback close-settings();
    callback save-settings();
    callback login();
    callback cancel-login();
    callback logout();

    title: "Wisdom";
    icon: @image-url("../assets/logo.png");
    preferred-width: 960px;
    preferred-height: 620px;
    background: #101114;

    VerticalBox {
        padding: 28px;
        spacing: 0px;

        HorizontalBox {
            height: 44px;
            Image {
                source: @image-url("../assets/logo.png");
                width: 34px;
                height: 34px;
                image-fit: contain;
                vertical-alignment: center;
            }
            Rectangle { width: 10px; }
            Text {
                text: "WISDOM";
                color: #f4f6fb;
                font-size: 20px;
                font-weight: 700;
                vertical-alignment: center;
            }
            Rectangle { horizontal-stretch: 1; }
            AccentButton {
                text: "Settings";
                enabled: !root.busy;
                min-width: 94px;
                min-height: 38px;
                fill: #2a2d35;
                clicked => { root.open-global-settings(); }
            }
            Rectangle { width: 8px; }
            if root.account-name == "": AccentButton {
                text: "Sign in with Microsoft";
                enabled: !root.busy;
                min-width: 210px;
                min-height: 38px;
                fill: root.accent-color;
                clicked => { root.login(); }
            }
            if root.account-name != "": Rectangle {
                width: root.account-width;
                min-height: 38px;
                background: #22252d;
                border-radius: 8px;
                clip: true;
                Image {
                    x: 0px;
                    y: 0px;
                    width: parent.height;
                    height: parent.height;
                    source: root.player-head;
                    source-clip-x: 8;
                    source-clip-y: 8;
                    source-clip-width: 8;
                    source-clip-height: 8;
                    image-fit: fill;
                    image-rendering: pixelated;
                }
                Text {
                    x: parent.height + 10px;
                    width: parent.width - parent.height - 20px;
                    text: root.account-name;
                    color: #ffffff;
                    font-size: 14px;
                    font-weight: 600;
                    vertical-alignment: center;
                }
            }
            if root.account-name != "": Rectangle { width: 8px; }
            if root.account-name != "": LogoutButton {
                width: 108px;
                min-height: 38px;
                clicked => { root.logout(); }
            }
        }

        Rectangle { height: 1px; background: #282b33; }

        Rectangle { vertical-stretch: 1; }

        HorizontalBox {
            Rectangle { horizontal-stretch: 1; }
            VerticalBox {
                width: 520px;
                spacing: 14px;
                Text {
                text: root.busy ? "Please wait" : (root.account-name == "" ? "Ready when you are" : "Welcome back, " + root.account-name);
                color: #f4f6fb;
                font-size: 30px;
                font-weight: 700;
                horizontal-alignment: center;
            }
                Text {
                text: root.status-text;
                color: #aab0bd;
                font-size: 14px;
                horizontal-alignment: center;
                width: 520px;
                wrap: word-wrap;
            }
                if root.show-progress: HorizontalBox {
                    Rectangle { horizontal-stretch: 1; }
                    Rectangle {
                        width: 310px;
                        height: 7px;
                        background: #282b33;
                        border-radius: 4px;
                        Rectangle {
                            width: parent.width * root.progress-value;
                            height: parent.height;
                            background: root.accent-color;
                            border-radius: 4px;
                        }
                    }
                    Rectangle { horizontal-stretch: 1; }
                }
                Rectangle { height: 12px; }
                AccentButton {
                text: root.busy ? "Preparing …" : "Start " + root.selected-version;
                enabled: !root.busy && root.selected-version != "";
                min-width: 310px;
                min-height: 58px;
                label-size: 18px;
                label-weight: 700;
                fill: root.accent-color;
                clicked => { root.start-game(); }
            }
                ComboBox {
                model: root.versions;
                current-index: root.selected-version-index;
                enabled: !root.busy;
                min-width: 310px;
                min-height: 42px;
                selected(value) => { root.select-version(self.current-index); }
                }
                CheckBox {
                    text: "Open Console";
                    checked: root.open-console;
                    enabled: !root.busy;
                    width: 310px;
                    toggled => { root.set-open-console(self.checked); }
                }
                HorizontalBox {
                    width: 310px;
                    spacing: 8px;
                    ComboBox {
                        model: root.instances;
                        current-index: root.selected-instance-index;
                        enabled: !root.busy;
                        horizontal-stretch: 1;
                        min-height: 38px;
                        selected(value) => { root.select-instance(self.current-index); }
                    }
                    AccentButton {
                        text: "+";
                        enabled: !root.busy;
                        min-width: 38px;
                        min-height: 38px;
                        fill: #30333a;
                        label-size: 20px;
                        clicked => { root.create-instance(); }
                    }
                    AccentButton {
                        text: "⚙";
                        enabled: !root.busy;
                        min-width: 38px;
                        min-height: 38px;
                        fill: #30333a;
                        label-size: 17px;
                        clicked => { root.open-instance-settings(); }
                    }
                }
            }
            Rectangle { horizontal-stretch: 1; }
        }

        Rectangle { vertical-stretch: 1; }
    }

    if root.show-login-dialog: Rectangle {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        background: #000000b8;

        Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: 460px;
            height: 300px;
            background: #1a1c22;
            border-radius: 14px;
            border-width: 1px;
            border-color: #363a45;

            VerticalBox {
                padding: 28px;
                spacing: 14px;
                Text {
                    text: "Sign in with Microsoft";
                    color: #f4f6fb;
                    font-size: 22px;
                    font-weight: 700;
                    horizontal-alignment: center;
                }
                Text {
                    text: "Finish sign-in in your browser";
                    color: #aab0bd;
                    font-size: 14px;
                    horizontal-alignment: center;
                }
                AccentButton {
                    text: "Cancel";
                    min-height: 38px;
                    fill: #30333a;
                    clicked => { root.cancel-login(); }
                }
            }
        }
    }

    if root.show-settings: Rectangle {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        background: #000000b8;
        Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: 500px;
            height: root.settings-global ? 420px : 570px;
            background: #1a1c22;
            border-radius: 14px;
            border-width: 1px;
            border-color: #363a45;
            VerticalBox {
                padding: 24px;
                spacing: 12px;
                Text {
                    text: root.settings-global ? "Global Settings" : "Instance Settings";
                    color: #f4f6fb;
                    font-size: 21px;
                    font-weight: 700;
                }
                if !root.settings-global: Field { label: "Instance name"; value <=> root.draft-name; }
                if !root.settings-global: Field { label: "Minecraft version"; value <=> root.draft-version; }
                CheckBox {
                    text: root.settings-global ? "Default RAM (MB)" : "Override global RAM (MB)";
                    checked: root.settings-global ? true : root.draft-ram-override;
                    enabled: !root.settings-global;
                    toggled => { root.draft-ram-override = self.checked; }
                }
                Field { label: "RAM (MB)"; value <=> root.draft-ram; }
                CheckBox {
                    visible: !root.settings-global;
                    text: "Override global JVM arguments";
                    checked <=> root.draft-jvm-override;
                }
                Field { label: "JVM arguments"; value <=> root.draft-jvm-args; }
                CheckBox {
                    visible: !root.settings-global;
                    text: "Override global game arguments";
                    checked <=> root.draft-game-override;
                }
                Field { label: "Game arguments"; value <=> root.draft-game-args; }
                Rectangle { vertical-stretch: 1; }
                HorizontalBox {
                    Rectangle { horizontal-stretch: 1; }
                    AccentButton { text: "Cancel"; min-width: 92px; min-height: 38px; fill: #30333a; clicked => { root.close-settings(); } }
                    AccentButton { text: "Save"; min-width: 92px; min-height: 38px; fill: root.accent-color; clicked => { root.save-settings(); } }
                }
            }
        }
    }
}
