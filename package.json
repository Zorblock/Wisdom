{
  "name": "wisdom-launcher",
  "private": true,
  "version": "1.0.0-beta",
  "description": "Wisdom Minecraft Launcher",
  "type": "module",
  "scripts": {
    "dev": "node ./node_modules/@tauri-apps/cli/tauri.js dev",
    "start": "node ./node_modules/@tauri-apps/cli/tauri.js dev",
    "frontend:dev": "vite --config src-tauri/vite.config.js",
    "check": "cargo check --manifest-path src-tauri/Cargo.toml",
    "build": "vite build --config src-tauri/vite.config.js",
    "build:release": "tauri build --no-bundle",
    "setup": "npm run build:release && powershell -NoProfile -ExecutionPolicy Bypass -File scripts/create-installer.ps1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "vite": "^7.0.0"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^7.3.1",
    "@tauri-apps/api": "^2.0.0",
    "ansi_up": "^6.0.6"
  }
}
