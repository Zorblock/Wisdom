{
  "name": "wisdom-launcher",
  "private": true,
  "version": "0.1.0",
  "description": "Wisdom Minecraft Launcher",
  "type": "module",
  "scripts": {
    "dev": "node ./scripts/dev.mjs",
    "start": "node ./scripts/dev.mjs",
    "frontend:dev": "vite --config src-tauri/vite.config.js",
    "check": "cargo check --manifest-path src-tauri/Cargo.toml",
    "build": "vite build --config src-tauri/vite.config.js",
    "build:release": "tauri build --no-bundle",
    "release": "node ./scripts/release.mjs",
    "release:windows": "node ./scripts/release.mjs"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "vite": "^7.0.0"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^7.3.1",
    "@tauri-apps/api": "^2.0.0",
    "ansi_up": "^6.0.6"
  }
}
